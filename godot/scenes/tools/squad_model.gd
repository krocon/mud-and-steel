class_name SquadModel
extends Node3D
## Root of an infantry squad scene (prompt 006), generated by
## tools/blender/kit/squad.py from assets-src/blueprints/<faction>/<squad_id>.toml.
## The children are soldier models of prompt 005 (`infantry/<role>.glb`) in
## formation; this script gives them their faction look and plays animations.
##
## Presentation only: positions here are a default formation, the simulation
## moves the soldiers itself.

## Faction of the soldiers (uniform colors, see SoldierLook).
@export var faction := "su"
## Apply the forest look and start `idle` when the scene enters the tree.
@export var autoplay := true

var _biome := "forest"


func _ready() -> void:
	if autoplay:
		apply_look("forest")
		play("idle")


## The soldier instances (direct children with a skeleton).
func soldiers() -> Array[Node3D]:
	var out: Array[Node3D] = []
	for c in get_children():
		if c is Node3D and SoldierLook.find_skeleton(c) != null:
			out.append(c)
	return out


## Uniform colors for a biome; each soldier gets its own stature, face and skin tone.
func apply_look(biome: String) -> void:
	_biome = biome
	var i := 0
	for s in soldiers():
		SoldierLook.apply(s, faction, biome, hash(name) + i)
		i += 1


func biome() -> String:
	return _biome


## Plays a clip on every soldier, slightly out of step so the squad does not
## move in unison. Returns the number of soldiers that have the clip.
func play(clip: String) -> int:
	var n := 0
	var i := 0
	for s in soldiers():
		var player := SoldierLook.find_player(s)
		i += 1
		if player == null or not player.has_animation(clip):
			continue
		SoldierLook.configure_animations(player)
		player.play(clip)
		var length := player.get_animation(clip).length
		player.seek(fmod(0.37 * i, maxf(length, 0.01)), true)
		n += 1
	return n


## Clip names shared by all soldiers (from animations.json).
static func clip_names() -> Array:
	return SoldierLook.clips().keys()
