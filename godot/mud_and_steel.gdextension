[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = true

[libraries]
macos.debug = "res://../target/debug/libbridge.dylib"
macos.release = "res://../target/release/libbridge.dylib"
linux.debug.x86_64 = "res://../target/debug/libbridge.so"
linux.release.x86_64 = "res://../target/release/libbridge.so"
linux.debug.arm64 = "res://../target/debug/libbridge.so"
linux.release.arm64 = "res://../target/release/libbridge.so"
windows.debug.x86_64 = "res://../target/debug/bridge.dll"
windows.release.x86_64 = "res://../target/release/bridge.dll"
