[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = true

; Debug: `just build` (target/debug). Release: only exported games use it;
; `tools/release/build-lib.sh` stages the release libraries in target/export/
; (macOS: one universal arm64 + x86_64 library). See docs/RELEASE.md.
[libraries]
macos.debug = "res://../target/debug/libbridge.dylib"
macos.release = "res://../target/export/libbridge.dylib"
linux.debug.x86_64 = "res://../target/debug/libbridge.so"
linux.release.x86_64 = "res://../target/export/libbridge.so"
linux.debug.arm64 = "res://../target/debug/libbridge.so"
linux.release.arm64 = "res://../target/export/libbridge.so"
windows.debug.x86_64 = "res://../target/debug/bridge.dll"
windows.release.x86_64 = "res://../target/export/bridge.dll"

; The bridge links Valve's steam_api dynamically (prompt 026, docs/ONLINE.md):
; an exported game ships it next to the bridge.
[dependencies]
macos.debug = { "res://../target/debug/libsteam_api.dylib": "Contents/Frameworks" }
macos.release = { "res://../target/export/libsteam_api.dylib": "Contents/Frameworks" }
linux.debug.x86_64 = { "res://../target/debug/libsteam_api.so": "" }
linux.release.x86_64 = { "res://../target/export/libsteam_api.so": "" }
windows.debug.x86_64 = { "res://../target/debug/steam_api64.dll": "" }
windows.release.x86_64 = { "res://../target/export/steam_api64.dll": "" }
