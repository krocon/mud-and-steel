; Engine configuration file.
; Godot rewrites this file when settings change in the editor.

config_version=5

[application]

config/name="Mud and Steel"
run/main_scene="res://scenes/menu/main_menu.tscn"
config/version="0.1.0"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

CrashGuard="*res://scenes/menu/crash_guard.gd"

[debug]

file_logging/enable_file_logging=true
file_logging/max_log_files=10

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/viewport_width.movie=1920
window/size/viewport_height.movie=1080

[editor]

movie_writer/mjpeg_quality=0.93

[rendering]

renderer/rendering_method="forward_plus"
limits/global_shader_variables/buffer_size=262144
textures/vram_compression/import_etc2_astc=true

[input]

camera_pan_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
camera_pan_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
camera_pan_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
