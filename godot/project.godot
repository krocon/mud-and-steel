; Engine configuration file.
; Godot rewrites this file when settings change in the editor.

config_version=5

[application]

config/name="Mud and Steel"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[rendering]

renderer/rendering_method="forward_plus"
limits/global_shader_variables/buffer_size=262144

[input]

camera_pan_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
camera_pan_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
camera_pan_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
camera_pan_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
camera_rotate_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":81)]
}
camera_rotate_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
camera_reset_north={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":78)]
}
camera_zoom_in={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":4,"pressed":true)]
}
camera_zoom_out={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":5,"pressed":true)]
}
camera_drag={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":3,"pressed":true)]
}

[importer_defaults]

scene={
"import_script/path": "res://assets/import/unit_post_import.gd"
}
